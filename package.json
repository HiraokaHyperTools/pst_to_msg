{
  "name": "@hiraokahypertools/pst_to_msg",
  "version": "0.5.0-alpha.1",
  "description": "Convert a message in Outlook PST file into MSG format",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "browser": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 20.6.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run test && npm run clean && npm run build",
    "test": "cross-env  jest",
    "test:watch": "cross-env  jest --watch",
    "test:coverage": "cross-env  jest --coverage",
    "test:ci": "cross-env  jest --coverage --watchAll=false"
  },
  "keywords": [
    "pst",
    "msg",
    "outlook",
    "email",
    "converter",
    "typescript"
  ],
  "repository": {
    "type": "https",
    "url": "https://github.com/HiraokaHyperTools/pst_to_msg.git"
  },
  "bugs": {
    "url": "https://github.com/HiraokaHyperTools/pst_to_msg/issues"
  },
  "homepage": "https://github.com/HiraokaHyperTools/pst_to_msg",
  "author": "kenjiuno",
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^24.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hiraokahypertools/pst-extractor": "^0.5.0-alpha.1",
    "@kenjiuno/msgreader-web-ng": "^0.2.0-alpha1"
  }
}
