{
  "name": "@hiraokahypertools/pst_to_msg",
  "version": "0.2.0-alpha.1",
  "description": "Convert a message in Outlook PST file into MSG format",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run test && npm run clean && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts"
  },
  "keywords": [
    "pst",
    "msg",
    "outlook",
    "email",
    "converter",
    "typescript"
  ],
  "repository": {
    "type": "https",
    "url": "https://github.com/HiraokaHyperTools/pst_to_msg.git"
  },
  "bugs": {
    "url": "https://github.com/HiraokaHyperTools/pst_to_msg/issues"
  },
  "homepage": "https://github.com/HiraokaHyperTools/pst_to_msg",
  "author": "kenjiuno",
  "license": "MIT",
  "private": false,
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-typescript"
    ],
    "plugins": [
      "@babel/plugin-proposal-class-properties"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^24.2.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-jest": "^30.2.0",
    "eslint": "^8.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hiraokahypertools/pst-extractor": "^0.2.0-alpha.2",
    "@kenjiuno/msgreader-web-ng": "^0.2.0-alpha1"
  }
}
